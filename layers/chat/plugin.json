{
  "id": "chat",
  "name": "Chat",
  "description": "Ask a model about your notes in a chat, with them as context and tools to work on them.",
  "icon": "i-lucide-message-square",
  "version": "0",
  "apiVersion": 1,
  "windows": [
    "session",
    "settings"
  ],
  "requires": [
    "ai",
    "workflows?"
  ],
  "permissions": [
    "network"
  ],
  "config": {
    "overridable": {
      "storage": "workspace",
      "mode": "workspace",
      "titles": "workspace",
      "importFiles": "workspace"
    },
    "schema": [
      {
        "key": "storage",
        "type": "select",
        "default": "app",
        "label": "plugins.chat.settings.storage",
        "description": "plugins.chat.settings.storageDescription",
        "info": "plugins.chat.settings.storageInfo",
        "options": [
          {
            "value": "app",
            "label": "plugins.chat.settings.storageApp"
          },
          {
            "value": "workspace",
            "label": "plugins.chat.settings.storageWorkspace"
          }
        ]
      },
      {
        "key": "mode",
        "type": "select",
        "default": "suggest",
        "label": "plugins.chat.settings.mode",
        "description": "plugins.chat.settings.modeDescription",
        "info": "plugins.chat.settings.modeInfo",
        "options": [
          {
            "value": "read",
            "label": "plugins.chat.settings.modes.read"
          },
          {
            "value": "suggest",
            "label": "plugins.chat.settings.modes.suggest"
          },
          {
            "value": "write",
            "label": "plugins.chat.settings.modes.write"
          }
        ]
      },
      {
        "key": "titles",
        "type": "switch",
        "default": true,
        "label": "plugins.chat.settings.titles",
        "description": "plugins.chat.settings.titlesDescription",
        "info": "plugins.chat.settings.titlesInfo"
      },
      {
        "key": "importFiles",
        "type": "select",
        "default": "ask",
        "label": "plugins.chat.settings.importFiles",
        "description": "plugins.chat.settings.importFilesDescription",
        "info": "plugins.chat.settings.importFilesInfo",
        "options": [
          {
            "value": "ask",
            "label": "plugins.chat.settings.importFilesAsk"
          },
          {
            "value": "always",
            "label": "plugins.chat.settings.importFilesAlways"
          }
        ]
      }
    ]
  }
}
