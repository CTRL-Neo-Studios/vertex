              "label": "Join",
              "ports": {
                "out": "out"
              }
            },
            "textContains": {
              "label": "{text} contains {search}",
              "description": "Ignores case.",
              "ports": {
                "text": "text",
                "search": "search",
                "result": "result"
              }
            },
            "replace": {
              "label": "Replace {search} with {replacement} in {text}",
