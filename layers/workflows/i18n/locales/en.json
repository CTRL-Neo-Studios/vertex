        "nodes": {
          "std": {
            "if": {
              "label": "If",
              "description": "Runs then or else, then continues on done. Values set in the branch stay visible after it.",
              "ports": {
                "condition": "condition",
                "then": "then",
                "else": "else",
                "done": "done"
              }
            },
            "forEach": {
              "label": "For Each",
              "description": "Runs body once per item, each in its own scope, then continues on done.",
              "ports": {
                "list": "list",
                "item": "item",
                "index": "index",
                "body": "body",
                "done": "done"
              }
            },
            "sequence": {
              "label": "Sequence",
              "description": "Runs then0, then1, … in order."
            },
            "try": {
              "label": "Try",
              "description": "Runs body; if it faults, runs catch with the error message. Then continues on done. Limits and aborts can't be caught.",
              "ports": {
                "error": "error",
                "body": "body",
                "catch": "catch",
                "done": "done"
              }
            },
            "equals": {
              "label": "{a} = {b}",
              "ports": {
                "a": "a",
                "b": "b",
                "result": "result"
              }
            },
            "not": {
              "label": "not {value}",
              "ports": {
                "value": "value",
                "result": "result"
              }
            },
            "and": {
              "label": "{a} and {b}",
              "ports": {
                "a": "a",
                "b": "b",
                "result": "result"
              }
            },
            "or": {
              "label": "{a} or {b}",
              "ports": {
                "a": "a",
                "b": "b",
                "result": "result"
              }
            },
            "add": {
              "label": "{a} + {b}",
              "ports": {
                "a": "a",
                "b": "b",
                "result": "result"
              }
            },
            "subtract": {
              "label": "{a} − {b}",
              "ports": {
                "a": "a",
                "b": "b",
                "result": "result"
              }
            },
            "multiply": {
              "label": "{a} × {b}",
              "ports": {
                "a": "a",
                "b": "b",
                "result": "result"
              }
            },
            "divide": {
              "label": "{a} ÷ {b}",
              "description": "Faults when b is 0.",
              "ports": {
                "a": "a",
                "b": "b",
                "result": "result"
              }
            },
            "remainder": {
              "label": "{a} mod {b}",
              "description": "What's left after dividing a by b, with the sign of b (-1 mod 3 is 2). Faults when b is 0.",
              "ports": {
                "a": "a",
                "b": "b",
                "result": "result"
              }
            },
            "round": {
              "label": "Round {value}",
              "ports": {
                "value": "value",
                "result": "result"
              }
            },
            "lessThan": {
              "label": "{a} < {b}",
              "ports": {
                "a": "a",
                "b": "b",
                "result": "result"
              }
            },
            "greaterThan": {
              "label": "{a} > {b}",
              "ports": {
                "a": "a",
                "b": "b",
                "result": "result"
              }
            },
            "now": {
              "label": "Now",
              "description": "The date and time (ISO 8601), read once per run: every use in a run sees the same.",
              "ports": {
                "date": "date"
              }
