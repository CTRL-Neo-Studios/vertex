              "ports": {
                "file": "file",
                "key": "key",
                "value": "value"
              }
            },
            "setProperty": {
              "label": "Set {key} of {file} to {value}",
              "description": "Sets a frontmatter property, creating the frontmatter if needed.",
              "ports": {
                "file": "file",
                "key": "key",
                "value": "value"
              }
            },
            "queryByTag": {
              "label": "Notes tagged {tag}",
