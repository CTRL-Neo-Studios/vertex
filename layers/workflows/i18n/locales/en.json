                "search": "search",
                "replacement": "replacement",
                "text": "text"
              }
            },
            "split": {
              "label": "Split {text} by {separator}",
              "ports": {
                "text": "text",
                "separator": "separator",
                "parts": "parts"
              }
            },
            "trim": {
              "label": "Trim {text}",
              "description": "Removes whitespace from both ends.",
              "ports": {
                "text": "text"
              }
            },
            "upperCase": {
              "label": "Uppercase {text}",
              "ports": {
                "text": "text"
              }
            },
