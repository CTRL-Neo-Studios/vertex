                "folder": "folder",
                "recursive": "in subfolders",
                "files": "files",
                "folders": "folders",
                "extensions": "extensions",
                "tag": "tag",
                "pattern": "pattern",
                "entries": "entries"
              }
            },
            "find": {
              "label": "Find {pattern}",
