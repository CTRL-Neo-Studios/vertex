{
  "name": "@type32/vertex-plugin",
  "version": "1.1.0",
  "private": false,
  "description": "Vertex SDK - Types, the host's shared modules and a Vite preset for Vertex community plugins.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts"
    },
    "./files": {
      "types": "./dist/types/shared/plugin/files.d.ts"
    },
    "./links": {
      "types": "./dist/types/shared/plugin/links.d.ts"
    },
    "./text": {
      "types": "./dist/types/shared/plugin/text.d.ts"
    },
    "./vault": {
      "types": "./dist/types/shared/plugin/vault.d.ts"
    },
    "./ui": {
      "types": "./dist/types/ui.d.ts"
    },
    "./vite": {
      "types": "./dist/types/packages/vertex-plugin/src/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./tailwind.css": "./dist/tailwind.css"
  },
  "imports": {
    "#shared/*": {
      "types": "./dist/types/shared/*.d.ts"
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc -p .",
    "release": "bun scripts/release.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@nuxt/ui": "^4.12.0",
    "@tailwindcss/vite": "^4.3.5",
    "@type32/codemirror-rich-obsidian-editor": "^0.5.0",
    "@type32/obsidian-bases-parser": "^0.5.1",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "6.0.3",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "@type32/workflows": "^0.1.3",
    "ai": "^7.0.172",
    "vite": "^8.3.8"
  },
  "peerDependenciesMeta": {
    "@type32/workflows": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  }
}
